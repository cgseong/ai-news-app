# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# 로그인 화면을 Clerk 호스팅 페이지 대신 앱 안의 /sign-in 으로 보냅니다.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/


# --- LLM provider: anthropic | openrouter (defaults to anthropic) ---
LLM_PROVIDER=anthropic

# Used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# Used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-opus-5-5
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI News Collector

# --- Notion (internal integration token) ---
NOTION_API_KEY=ntn_...
NOTION_DATABASE_ID=
