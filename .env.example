# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# 로그인 화면을 Clerk 호스팅 페이지 대신 앱 안의 /sign-in 으로 보냅니다.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/


# --- LLM provider: openrouter | anthropic (defaults to openrouter) ---
LLM_PROVIDER=openrouter

# Used when LLM_PROVIDER=openrouter.
# 모델 ID는 벤더 접두사가 필요합니다. 요약·분류는 단순한 작업이라 haiku로 충분하고,
# 품질을 올리고 싶으면 이 줄만 anthropic/claude-sonnet-5.5 로 바꾸면 됩니다.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI News Collector

# Used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# --- Notion (internal integration token) ---
NOTION_API_KEY=ntn_...
NOTION_DATABASE_ID=
